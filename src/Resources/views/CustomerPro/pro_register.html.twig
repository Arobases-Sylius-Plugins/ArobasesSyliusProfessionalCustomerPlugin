{% extends '@SyliusShop/layout.html.twig' %}

{% form_theme form '@SyliusShop/Form/theme.html.twig' %}

{% block title %}{{ 'arobases_sylius_professional_customer.ui.register_in_the_store'|trans }} | {{ parent() }}{% endblock %}

{% block content %}
    {% include '@ArobasesSyliusProfessionalCustomerPlugin/CustomerPro/Register/_header.html.twig' %}

    {{ sylius_template_event('arobases_sylius_professional_customer.shop.pro_register.after_content_header') }}

    <div class="ui padded segment">
        {{ sylius_template_event('sylius.shop.register.before_form') }}

        {{ form_start(form, {'action': path('arobases_sylius_professional_customer_shop_register'), 'attr': {'class': 'ui loadable form', 'novalidate': 'novalidate'}}) }}
        {% include '@ArobasesSyliusProfessionalCustomerPlugin/CustomerPro/_form.html.twig' %}

        {{ sylius_template_event('sylius.shop.register.form', {'form': form}) }}

        <button type="submit" class="ui large primary button" {{ sylius_test_html_attribute('register-button') }}>
            {{ 'sylius.ui.create_an_account'|trans }}
        </button>
        {{ form_row(form._token) }}
        {{ form_end(form, {'render_rest': false}) }}
    </div>
{% endblock %}
