{% set customer = hookable_metadata.context.customer %}

<div class="card border-0 bg-body-tertiary mb-4" {{ sylius_test_html_attribute('professional-information') }}>
    <div class="card-body">
        <div class="mb-3">
            {% if customer.isProVerified %}
                <span class="badge text-bg-primary text-white">{{ 'sylius.ui.verified'|trans }}</span>
            {% else %}
                <span class="badge text-bg-danger">{{ 'sylius.ui.not_verified'|trans }}</span>
            {% endif %}
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-5">{{ 'sylius.ui.name'|trans }}</dt>
            <dd class="col-sm-7">{{ customer.fullName }}</dd>
            <dt class="col-sm-5">{{ 'sylius.ui.email'|trans }}</dt>
            <dd class="col-sm-7">{{ customer.email }}</dd>
            <dt class="col-sm-5">{{ 'arobases_sylius_professional_customer.form.customer_pro.socialReason'|trans }}</dt>
            <dd class="col-sm-7">{{ customer.socialReason }}</dd>
            <dt class="col-sm-5">{{ 'arobases_sylius_professional_customer.form.customer_pro.vatNumber'|trans }}</dt>
            <dd class="col-sm-7">{{ customer.vatNumber }}</dd>
            <dt class="col-sm-5">{{ 'arobases_sylius_professional_customer.form.customer_pro.business_registration_number.label'|trans }}</dt>
            <dd class="col-sm-7">{{ customer.businessRegistrationNumber }}</dd>
        </dl>
    </div>
</div>

{% if customer.filePath is not null %}
    <div class="card border-0 bg-body-tertiary">
        <div class="card-body">
            <h2 class="h5">{{ 'arobases_sylius_professional_customer.ui.kbis'|trans }}</h2>
            <object data="{{ asset(customer.filePath) }}" type="application/pdf" width="100%" height="500">
                {{ 'arobases_sylius_professional_customer.ui.display_fail'|trans }}
            </object>
            <a href="{{ asset(customer.filePath) }}" target="_blank">{{ 'arobases_sylius_professional_customer.ui.download'|trans }}</a>
        </div>
    </div>
{% endif %}
